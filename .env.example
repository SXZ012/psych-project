# ============================================================
# 高责任岗位心理测评系统 · 环境变量模板
# 用法: cp .env.example .env  然后填入真实值。  .env 切勿提交。
# ============================================================

# ---------- 应用 ----------
APP_NAME=高责任岗位心理测评系统
ENV=dev                  # dev | prod
DEBUG=true
SQL_ECHO=false            # true 时打印 SQL（调试用，默认关以保持日志清爽）
SECRET_KEY=please-change-me-to-a-random-string
ADMIN_PASSWORD=psych-admin      # 后台 /admin 登录口令（生产改强密码）
CORS_ORIGINS=*           # 多个用逗号: http://localhost:5173,http://localhost:3000
ASSESSMENT_DURATION_SECONDS=60   # 方案: 60秒快筛

# ---------- 路线开关 (方案 Demo 路线 A/B) ----------
PROVIDER_MODE=mock       # mock=路线B(本地闭环)  |  real=路线A(真实API联调)

# ---------- PostgreSQL ----------
POSTGRES_USER=psych
POSTGRES_PASSWORD=psych
POSTGRES_DB=psych
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# 留空则由上面四项自动拼接为 postgresql+asyncpg://...
DATABASE_URL=

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
ADMINER_PORT=8080

# ---------- 阿里云百炼 / QwenPlus (报告生成) ----------
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---------- 阿里云 OSS (图片存储) ----------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET_NAME=psych-test-bucket

# ---------- V3 心理生理状态评估算法（合作方）----------
# 真实联调(路线A)时填入；Mock(路线B)模式可留空。
V3_API_ROOT=https://me.i-llusion.cn
V3_BASIC_TOKEN=                 # 鉴权头: Authorization: Token <V3_BASIC_TOKEN>
V3_ALG_SERVICE_UUID=
V3_OSS_BUCKET_ID=1
V3_POLL_INTERVAL=5              # 任务轮询间隔(秒)
V3_POLL_TIMEOUT=600             # 任务轮询超时(秒)
