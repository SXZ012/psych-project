# 文本文件入库统一为 LF，避免 Windows/WSL 混用导致 CRLF 反复横跳
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制：不做换行符处理与文本 diff
*.png binary
*.wav binary
*.mp3 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webm binary
*.mp4 binary
*.mov binary
*.apk binary
*.msi binary
*.pdf binary
*.xlsx binary
*.xls binary
*.docx binary
*.wasm binary
*.task binary
